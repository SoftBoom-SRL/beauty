# Copia in .env e personalizza
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=*

# Postgres in produzione (Railway/Render). Se assente: SQLite locale.
# DATABASE_URL=postgres://user:pass@host:5432/youty

# CORS (produzione): origini dei due frontend, separate da virgola
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com,https://app.example.com

# JWT (default: usa SECRET_KEY)
# JWT_SECRET=

# Stripe — se assenti, gli endpoint di pagamento rispondono 503
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Stripe Connect: ogni salone collega il SUO account Stripe (modello Standard +
# direct charges) e incassa lui caparre e mancate presentazioni — è lui il
# merchant of record e la piattaforma non trattiene commissioni.
# ca_… si trova in Stripe Dashboard → Connect → Impostazioni (chiave della piattaforma).
# Va inserito anche il redirect URI consentito:
#   http://localhost:5173/oauth-popup/stripe-done
# STRIPE_CONNECT_CLIENT_ID=ca_...
#
# Origine dell'app cliente: ritorno dal Checkout della caparra.
# CLIENT_APP_ORIGIN=http://localhost:5174

# Yourang — outbox WhatsApp/automazioni (API non ancora disponibili)
# YOURANG_API_URL=
# YOURANG_API_KEY=

# Yourang — connessione OAuth2 + sync (apps.integrations). Stesse convenzioni di
# food/real_estate. Client provisionato lato Yourang; redirect_uri:
#   http://localhost:5173/oauth-popup/done
# YOURANG_ISSUER_URL=https://api.yourang.ai
# YOURANG_CLIENT_ID=beauty-crm
# YOURANG_CLIENT_SECRET=
# YOURANG_WEBHOOK_RECEIVER_URL=http://host.docker.internal:8001/api/integrations/yourang/webhook
# FRONTEND_ORIGIN=http://localhost:5173
# Cifratura token a riposo (AES-256-GCM), 32 byte hex: openssl rand -hex 32
# ENCRYPTION_KEY=

# Yourang — dove rimandare l'utente quando uno strumento non è disponibile.
# ATTIVAZIONE: salone non collegato → richiesta info e setting con gli specialisti.
# RICARICA: salone collegato ma senza credito → acquisto di nuovo credito sulla
# piattaforma. Se vuota si ricade sull'URL di attivazione.
# YOURANG_ACTIVATION_URL=https://yourang.ai/contact
# YOURANG_TOPUP_URL=
