# Copia in .env e personalizza
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=*

# Postgres in produzione (Railway/Render). Se assente: SQLite locale.
# DATABASE_URL=postgres://user:pass@host:5432/youty

# CORS (produzione): origini dei due frontend, separate da virgola
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com,https://app.example.com

# JWT (default: usa SECRET_KEY)
# JWT_SECRET=

# Stripe — se assenti, gli endpoint di pagamento rispondono 503
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Yourang — outbox WhatsApp/automazioni (API non ancora disponibili)
# YOURANG_API_URL=
# YOURANG_API_KEY=

# Yourang — connessione OAuth2 + sync (apps.integrations). Stesse convenzioni di
# food/real_estate. Client provisionato lato Yourang; redirect_uri:
#   http://localhost:5173/oauth-popup/done
# YOURANG_ISSUER_URL=https://api.yourang.ai
# YOURANG_CLIENT_ID=beauty-crm
# YOURANG_CLIENT_SECRET=
# YOURANG_WEBHOOK_RECEIVER_URL=http://host.docker.internal:8001/api/integrations/yourang/webhook
# FRONTEND_ORIGIN=http://localhost:5173
# Cifratura token a riposo (AES-256-GCM), 32 byte hex: openssl rand -hex 32
# ENCRYPTION_KEY=
