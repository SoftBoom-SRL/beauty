# Copia in .env e personalizza
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=*

# Postgres in produzione (Railway/Render). Se assente: SQLite locale.
# DATABASE_URL=postgres://user:pass@host:5432/youty

# CORS (produzione): origini dei due frontend, separate da virgola
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com,https://app.example.com

# JWT (default: usa SECRET_KEY)
# JWT_SECRET=

# Stripe — se assenti, gli endpoint di pagamento rispondono 503
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Yourang — integrazione futura (API non ancora disponibili)
# YOURANG_API_URL=
# YOURANG_API_KEY=

# Twilio SMS — consegna OTP via SMS. Se una manca, l'SMS è disattivato
# (fallback: codice solo nel log in DEBUG). Servono tutte e tre.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_SMS_FROM=+39...
