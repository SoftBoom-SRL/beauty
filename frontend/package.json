{
  "name": "youty-frontend",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:dashboard": "npm run dev --workspace apps/dashboard",
    "dev:client": "npm run dev --workspace apps/client-app",
    "build": "npm run build --workspace apps/dashboard && npm run build --workspace apps/client-app",
    "test": "node --import ./test/register.mjs --test 'packages/shared/test/*.test.js' 'apps/dashboard/test/*.test.js' 'apps/client-app/test/*.test.js'",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0"
  }
}
